# Biblionx Libraske Processor Configuration

# RabbitMQ Message Broker Configuration
BIBLIONX_AMQP_HOST=localhost
AMQP_HOST=localhost
BIBLIONX_AMQP_PORT=5672
AMQP_PORT=5672
BIBLIONX_AMQP_USER=guest
AMQP_USER=guest
BIBLIONX_AMQP_PASS=guest
AMQP_PASS=guest
BIBLIONX_AMQP_PREFETCH_COUNT=1
AMQP_PREFETCH_COUNT=1

# Worker Queue Configuration
BIBLIONX_RECEIVE_QUEUE=frame_sender
RECEIVE_QUEUE=frame_sender
